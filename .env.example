# GEMINI_API_KEY: Required for Gemini AI (format, translate, generate lesson/image).
# Get key: https://aistudio.google.com/apikey — paste without extra spaces/BOM.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Database (choose ONE option) ---

# Option A (recommended): Neon PostgreSQL — copy connection string from Neon Console
# Dashboard: https://console.neon.tech/app/projects/odd-sky-70753765
# Use "Connection string" → Node.js / psql (must include ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Option B: Local PostgreSQL (when DATABASE_URL is empty)
PGHOST=localhost
PGPORT=5432
PGDATABASE=khmer_lesson_doc
PGUSER=postgres
PGPASSWORD=your_password

# Google Sign-In (optional) — OAuth 2.0 Client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

API_PORT="3001"

# Frontend API base URL used by Vite app (browser must reach this URL)
# Local: http://localhost:3001
# Vercel: leave empty (same-origin /api routes)
# Docker/server: http://YOUR_SERVER_IP:3001 or https://api.yourdomain.com
VITE_API_BASE_URL="http://localhost:3001"

# Watchtower (optional): check for new images every N seconds (default 86400 = 24h)
WATCHTOWER_POLL_INTERVAL=86400
TZ=Asia/Phnom_Penh
